@ECHO OFF
REM MiSTer media helper shim — prefer DRIVERS\IMGTRY.BAT from distro.
REM If called as C:\DRIVERS\HW\IMGTRY.BAT, forward to PATH copy.
IF EXIST C:\DRIVERS\IMGTRY.BAT GOTO USEDRV
IF EXIST C:\MYMENU\UTILS\IMGTRY.BAT GOTO USEMENU
ECHO IMGTRY: MiSTer imgtry helper not found
GOTO END

:USEDRV
CALL C:\DRIVERS\IMGTRY.BAT %1 %2 %3 %4 %5 %6 %7 %8 %9
GOTO END

:USEMENU
CALL C:\MYMENU\UTILS\IMGTRY.BAT %1 %2 %3 %4 %5 %6 %7 %8 %9
GOTO END

:END
